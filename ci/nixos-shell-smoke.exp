#!/usr/bin/expect -f
# Boot through the public launcher with a PTY and builds disabled.
set timeout 300
set launcher [lindex $argv 0]
spawn nix run --builders "" --max-jobs 0 $launcher

proc fail {message} {
    puts stderr $message
    exit 1
}

expect {
    -re {nixos@nixos-shell:[^\r\n]*\]\$} {}
    timeout { fail "Timed out waiting for the guest shell" }
    eof { fail "The launcher exited before the guest shell was ready" }
}

# Logged in as nixos, with sudo; writes and then edits a file in the shared
# folder, which the workflow then reads on the host. Split the marker so the
# echoed command cannot satisfy the check.
send -- {test "$(id -un)" = nixos && sudo -n true && test "$(uname -sm)" = "Linux aarch64" && nix --version | grep 'Determinate Nix' && jq --version && rg --version && echo one > /tmp/shared/smoke && echo two >> /tmp/shared/smoke && printf '%s%s\n' NIXOS_SHELL_ SMOKE_OK}
send -- "\r"
expect {
    "NIXOS_SHELL_SMOKE_OK" {}
    timeout { fail "The guest CLI checks did not pass" }
    eof { fail "The launcher exited before the guest CLI checks completed" }
}

send -- "sudo poweroff\r"
expect {
    eof {}
    timeout { fail "Timed out waiting for the guest to power off" }
}
set result [wait]
if {[lrange $result 2 end] ne {0 0}} {
    fail "The VM launcher did not exit cleanly"
}
