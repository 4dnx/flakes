<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Forces Sparkle's scheduled update check and automatic installation off in
  the net.whatsapp.WhatsApp domain, for installs whose version Nix manages.
  WhatsApp turns both back on in its user preferences; managed preferences
  take precedence over them. Checks the app starts itself still run. See
  pkgs/whatsapp/README.md.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>net.whatsapp.WhatsApp</string>
      <key>PayloadIdentifier</key>
      <string>io.github.xr3t.flakes.whatsapp.updates.settings</string>
      <key>PayloadUUID</key>
      <string>7FFD5000-0608-48D8-B803-92C855FC8802</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadDisplayName</key>
      <string>WhatsApp updates</string>
      <key>SUEnableAutomaticChecks</key>
      <false/>
      <key>SUAutomaticallyUpdate</key>
      <false/>
    </dict>
  </array>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadIdentifier</key>
  <string>io.github.xr3t.flakes.whatsapp.updates</string>
  <key>PayloadUUID</key>
  <string>B6CB667F-F5F1-4889-9740-870DCF10FF1A</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadDisplayName</key>
  <string>WhatsApp: updates through Nix</string>
  <key>PayloadDescription</key>
  <string>Turns off WhatsApp's automatic installation of updates and Sparkle's scheduled update check (SUAutomaticallyUpdate and SUEnableAutomaticChecks), because Nix installs its updates. Checks the app starts itself still run. Remove this profile to turn them back on.</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
</dict>
</plist>
